# Ghostty configuration
# Reload after editing: Cmd+Shift+, (or quit & reopen).

# --- Theme ---
theme = "Gruvbox Material Dark"
background = 1d2021

# --- Font ---
# Ghostty's default rendering is crisper than iTerm2. To use a Nerd Font
# (needed for nvim's file-tree/Telescope icons), install one and uncomment:
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
# font-thicken makes text less "shallow"/thin on macOS:
font-thicken = true

# --- Window ---
window-padding-x = 8
window-padding-y = 6
macos-titlebar-style = tabs

# --- Behavior ---
cursor-style = block
mouse-hide-while-typing = true
# macos-option-as-alt: 'true' turns Option into Alt/Meta, which breaks macOS
# Option+Delete (word-delete) — it sends <Esc> and drops nvim to normal mode.
# Left off so Option+Delete works normally. If you ever want Alt-keymaps in nvim,
# use 'right' (right-Option = Alt, left-Option keeps normal text editing):
# macos-option-as-alt = right
