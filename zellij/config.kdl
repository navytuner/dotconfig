theme "gruvbox-dark"

// macOS clipboard: selected/copied text goes to the system clipboard.
// copy_command "pbcopy"

// Bigger scrollback buffer.
scroll_buffer_size 20000

// Draw borders + titles around panes.
pane_frames true

// Use your login shell for new panes.
default_shell "zsh"

keybinds {
    unbind "Ctrl s" "Ctrl o" "Ctrl p" "Ctrl n" "Ctrl t" "Ctrl h" "Ctrl g"
    unbind "Alt f" "Alt b"
    tmux {
        bind "w" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; }
        bind "l" { MoveFocus "Right"; }
        bind "j" { MoveFocus "Down"; }
        bind "k" { MoveFocus "Up"; }
        bind "n" { GoToNextTab; }
        bind "p" { GoToPreviousTab; }
        bind "$" { SwitchToMode "RenameSession"; SessionNameInput 0; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "<" { MoveTab "Left"; }
        bind ">" { MoveTab "Right"; }
    }
}
show_startup_tips false
